{
	"openapi": "3.0.0",
	"info": {
		"title": "Tetra Master API",
		"description": "API for managing and retrieving card data for Tetra Master.",
		"version": "1.0.0"
	},
	"paths": {
		"/cards": {
			"get": {
				"summary": "Retrieve a list of cards",
				"responses": {
					"200": {
						"description": "A list of card objects",
						"content": {
							"application/json": {
								"schema": {
									"type": "array",
									"items": {
										"$ref": "#/components/schemas/Card"
									}
								}
							}
						}
					}
				}
			}
		}
	},
	"components": {
		"schemas": {
			"Card": {
				"type": "object",
				"required": ["id", "handle", "field", "label", "stats"],
				"properties": {
					"id": { "type": "integer", "example": 1 },
					"handle": { "type": "string", "example": "goblin-1" },
					"field": { "type": "string", "example": "card" },
					"label": { "type": "string", "example": "Goblin" },
					"stats": { "type": "string", "example": "0P00" },
					"dropped": {
						"type": "array",
						"items": { "type": "string" },
						"example": ["enemy 01", "Enemy 02"]
					},
					"found": { "type": "string", "example": "location 01" },
					"won": { "type": "string", "example": "person 01" },
					"missable": { "type": "boolean", "example": false },
					"image": { "type": "string", "example": "/assets/dist/images/cactaur.png" }
				}
			}
		}
	}
}
